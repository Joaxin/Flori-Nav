# 复制为 .env 后按需修改；.env 已在 .gitignore 里，不会进仓库。

# 生产必须设 False，并同时提供 DJANGO_SECRET_KEY
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=dev-only-insecure-key-change-me-before-deploying

# 逗号分隔；Vercel 预览域名每次都变，线上可先留空（settings 默认 *）
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=

# 留空 → 本地 SQLite；填 Postgres 连接串 → 走 Postgres
# 注意用服务商的连接池端点（Neon 带 -pooler 的主机、Supabase 的 pooler），不要直连主库
# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/flori_nav?sslmode=require

# 全库链接测活的总预算（秒），默认 60；Vercel 函数时长有限，别调太大
NAV_LINK_TOTAL_TIMEOUT=60

# 公网部署必配：设置后写接口和主人页都要求这个令牌
# 生成：python -c "import secrets; print(secrets.token_urlsafe(32))"
NAV_WRITE_TOKEN=

# 本机自测内网站点时设 1；公网不要开
NAV_ALLOW_PRIVATE_NET=

SFLORA_LOG_LEVEL=INFO
